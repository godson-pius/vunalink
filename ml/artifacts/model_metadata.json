{
  "name": "VunaLink MobileNetV2",
  "version": "0.1.0",
  "format": "saved_model",
  "dataset": "PlantVillage",
  "class_count": 6,
  "input": {
    "width": 224,
    "height": 224,
    "channels": 3,
    "dtype": "float32",
    "color_format": "RGB",
    "tensor_layout": "NHWC"
  },
  "preprocessing": {
    "resize": "image_dataset_from_directory target size",
    "scaling": "mobilenet_v2.preprocess_input",
    "formula": "(pixel / 127.5) - 1",
    "channel_order": "RGB"
  },
  "output": {
    "shape": [
      null,
      6
    ],
    "dtype": "float32",
    "semantics": "softmax class probabilities"
  },
  "class_mapping": "class_mapping.json",
  "classes": [
    "Potato___Early_blight",
    "Potato___Late_blight",
    "Potato___healthy",
    "Tomato___Early_blight",
    "Tomato___Late_blight",
    "Tomato___healthy"
  ],
  "training": {
    "input_width": 224,
    "input_height": 224,
    "batch_size": 32,
    "epochs": 20,
    "fine_tune_epochs": 5,
    "learning_rate": 0.001
  },
  "best_checkpoint": "best_model.keras"
}
